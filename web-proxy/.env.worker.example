# INFFOLER AI Worker secrets (Cloudflare Worker / Node proxy)
# Copy real values into Cloudflare Worker Secrets (wrangler secret put <NAME>)
# or export them in your server environment. NEVER commit real keys.

# OpenAI (default provider) — required for gpt-4.1-mini, gpt-4.1, gpt-4o-mini, o4-mini
OPENAI_API_KEY=

# Google Gemini — required for gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.5-pro
GEMINI_API_KEY=

# Optional: override the Firebase Auth project ID used for token verification
# FIREBASE_PROJECT_ID=gen-lang-client-0028400465
